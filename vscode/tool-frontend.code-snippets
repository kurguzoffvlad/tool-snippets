  "tool-ts-proxy-log": {
    "prefix": "tool-ts-proxy-log",
    "body": [
      "public createProxyLog(target, onChange) {",
      "    // Обработка null и примитивов",
      "    if (target === null || typeof target !== 'object') {",
      "        return target;",
      "    }",
      "  ",
      "    return new Proxy(target, {",
      "        set(obj, prop, value) {",
      "            const oldValue = obj[prop];",
      "          ",
      "            // Рекурсивно обрабатываем новые объекты",
      "            const newValue = this.createProxyLog(value, onChange);",
      "          ",
      "            obj[prop] = newValue;",
      "          ",
      "            // Проверяем реальное изменение (учитываем NaN)",
      "            if (oldValue !== value && !(Number.isNaN(oldValue) && Number.isNaN(value))) {",
      "                onChange(prop, newValue, oldValue);",
      "            }",
      "          ",
      "            return true;",
      "        },",
      "    ",
      "        get(obj, prop) {",
      "            const value = obj[prop];",
      "          ",
      "            // Рекурсивно создаем прокси для вложенных объектов",
      "            if (value !== null && typeof value === 'object') {",
      "                return this.createProxyLog(value, onChange);",
      "            }",
      "          ",
      "            return value;",
      "        },",
      "    ",
      "        deleteProperty(obj, prop) {",
      "            const oldValue = obj[prop];",
      "            const deleted = delete obj[prop];",
      "          ",
      "            if (deleted) { onChange(prop, undefined, oldValue); }",
      "          ",
      "            return deleted;",
      "        }",
      "    });",
      "}",
      "",
      "",
      "// Использование:",
      "//let state = this.createProxyLog(",
      "//{ user: { name: 'Alice', age: 30 } settings: { theme: 'dark', notifications: true } }, ",
      "//(prop, value, oldValue) => { console.log(`Property \"${prop}\" changed: ${oldValue} → ${value}`); });",
      "//",
      "// delete state.user.email;        // Property \"email\" changed: alice@example.com → undefined",
      "$0"
    ],
    "description": "Функция создания Proxy Логирование",
    "scope": "javascript,typescript"
  },
